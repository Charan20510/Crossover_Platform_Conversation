# ============================================================
# Environment variables — copy this to .env and fill in values
# ============================================================

# Django settings
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
USE_SQLITE=true

# Database (ignored if USE_SQLITE=true)
DB_NAME=wa_gateway
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Node worker
WORKER_BASE_URL=http://localhost:3000
DJANGO_WEBHOOK_URL=http://localhost:8000/webhook/incoming

# Worker port
WORKER_PORT=3000

# Node mail worker
MAIL_WORKER_BASE_URL=http://localhost:3002
DJANGO_MAIL_WEBHOOK_URL=http://localhost:8000/webhook/mail
WORKER_MAIL_PORT=3002

# Default country code (91 = India)
DEFAULT_COUNTRY_CODE=91

# Logging
LOG_LEVEL=info
